# Tasko Render / local environment. NEVER expose these values to the browser.
PORT=3000
TASKO_DEV_MODE=true
TASKO_POSTBACK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Owner emergency/security PINs — set unique 4-digit values in Render.
TASKO_PIN_OWNER1=CHANGE_ME
TASKO_PIN_OWNER2=CHANGE_ME

# Admin emergency/security PINs — each admin has a separate secret.
TASKO_PIN_ADMIN_OPERATIONS=CHANGE_ME
TASKO_PIN_ADMIN_USERS=CHANGE_ME
TASKO_PIN_ADMIN_TASKS=CHANGE_ME
TASKO_PIN_ADMIN_SUPPORT=CHANGE_ME

# Backward-compatible local-only names (optional; prefer the names above).
# TASKO_PIN_OWNER=CHANGE_ME
# TASKO_PIN_ADMIN_DEMO=CHANGE_ME

# Social login / anti-bot providers (secrets stay server-side).
TASKO_PUBLIC_URL=https://your-tasko-domain.example
TASKO_GOOGLE_CLIENT_ID=CHANGE_ME
TASKO_GOOGLE_CLIENT_SECRET=CHANGE_ME
TASKO_FACEBOOK_APP_ID=CHANGE_ME
TASKO_FACEBOOK_APP_SECRET=CHANGE_ME
TASKO_TURNSTILE_SITE_KEY=CHANGE_ME
TASKO_TURNSTILE_SECRET=CHANGE_ME

# Optional SMS provider for phone-change OTP. In production configure these to actually send SMS.
TASKO_SMS_PROVIDER_URL=
TASKO_SMS_PROVIDER_TOKEN=

# Optional email OTP delivery (production). If omitted, development returns the OTP in the UI.
RESEND_API_KEY=
TASKO_EMAIL_FROM=
