# Tasko Render / local environment. NEVER expose these values to the browser.
PORT=3000
TASKO_DEV_MODE=true
TASKO_POSTBACK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Owner emergency/security PINs — set unique 4-digit values in Render.
TASKO_PIN_OWNER1=CHANGE_ME
TASKO_PIN_OWNER2=CHANGE_ME

# Admin emergency/security PINs — each admin has a separate secret.
TASKO_PIN_ADMIN_OPERATIONS=CHANGE_ME
TASKO_PIN_ADMIN_USERS=CHANGE_ME
TASKO_PIN_ADMIN_TASKS=CHANGE_ME
TASKO_PIN_ADMIN_SUPPORT=CHANGE_ME

# Backward-compatible local-only names (optional; prefer the names above).
# TASKO_PIN_OWNER=CHANGE_ME
# TASKO_PIN_ADMIN_DEMO=CHANGE_ME
